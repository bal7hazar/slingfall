# The client's Sepolia variables, for a build or a dev server of your own: copy to
# client/.env.sepolia.local (git-ignored, read after client/.env.sepolia) or export them in the
# shell. Public values only; never a key. docs/testers.md.
VITE_NETWORK=sepolia
VITE_SLINGFALL_ADDRESS=0x4b645fe7cf06775c99c61148097b3aecabb67eacfd2937e0431affef5000ae2
# A Sepolia RPC 0.8+ endpoint (the public node below is rate limited; your own key stays here, not in git).
VITE_STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
# services/prove/prove_service.py serve (default port 8549); empty: the page requests no proof.
VITE_PROVE_URL=http://127.0.0.1:8549
# services/attest/attest.py serve (default port 8547); only for a Stub deployment.
VITE_ATTEST_URL=

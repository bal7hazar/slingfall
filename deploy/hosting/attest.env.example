# /etc/slingfall/attest.env: the environment of slingfall-attest.service (docs/hosting.md).
# Owner root, group the service user, mode 0640: the RPC URL may carry a provider key.
# Placeholders only: replace every <...>. Never put the attestation key itself here.

# The attestation key, read by attest.py from this file (owner the service user, mode 0600).
SLINGFALL_ATTEST_KEY_FILE=/etc/slingfall/attest.key

# The deployed Slingfall contract (v2) this service signs for: part of every signed message.
ATTEST_CONTRACT=<0x... the Slingfall contract address on Sepolia>

# Starknet RPC: chain id, attestation_epoch(), current_program() and the latest block's time.
STARKNET_RPC_URL=<https://... a Sepolia RPC endpoint>

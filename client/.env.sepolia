# Starknet Sepolia, public values only (never a key): `npm run dev:sepolia`, `npm run build:sepolia`
# (Vite mode `sepolia`; docs/testers.md). The address is deploy/sepolia.json's (checked by
# src/chain/config.test.ts). A variable of the same name in the shell wins over this file.
VITE_NETWORK=sepolia
VITE_SLINGFALL_ADDRESS=0x292f4b7dcbdb3ee7e5c3d1873e36ac03c71f3d4d5146ff009bcdf6e8bca4a02
VITE_STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
# The block of the "deploy Slingfall" transaction (deploy/sepolia.json), so that the player's
# LevelValidated history pages from here instead of genesis (m10).
VITE_DEPLOY_BLOCK=15729982
# The prover service of the settled tier (services/prove/prove_service.py serve), for example
# http://127.0.0.1:8549 when run locally. Empty: the page requests no proof.
VITE_PROVE_URL=
# The attestation service of the provisional tier (services/attest/attest.py serve --execute): the
# v2 deployment's verifier is Stub (both tiers). Empty: http://127.0.0.1:8547, a local service (no
# hosted one yet).
VITE_ATTEST_URL=

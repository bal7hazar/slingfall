+    /// G1b spike: reserves room for `additional` more cells in a segment, so that the segment
+    /// grows without the doubling copies of `insert`. Returns `false` if the segment does not
+    /// exist or the allocation fails.
+    pub fn reserve_segment(&mut self, segment_index: isize, additional: usize) -> bool {
+        let key = Relocatable::from((segment_index, 0));
+        match self.get_segment(key) {
+            Ok(segment) => segment.try_reserve_exact(additional).is_ok(),
+            Err(_) => false,
+        }
+    }
+
+    /// G1b spike: `(len, capacity)` of every non-temporary segment, in cells.
+    pub fn segment_capacities(&self) -> Vec<(usize, usize)> {
+        self.data.iter().map(|s| (s.len(), s.capacity())).collect()
+    }

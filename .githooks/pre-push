#!/usr/bin/env bash
# Runs scripts/prepush.sh before every push and blocks the push when it fails. Install once per clone:
# scripts/install-hooks.sh. Never skip it (no --no-verify): fix what it reports.
# Nothing to check for a branch delete or a tag-only push.
set -euo pipefail
zero=0000000000000000000000000000000000000000
check=0
while read -r local_ref local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in refs/tags/*) continue ;; esac
  check=1
done
[ "$check" = 1 ] || exit 0
cd "$(git rev-parse --show-toplevel)"
exec scripts/prepush.sh
